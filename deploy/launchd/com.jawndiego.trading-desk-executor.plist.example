<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jawndiego.trading-desk-testnet-executor</string>

  <key>UserName</key>
  <string>__REVIEWED_EXECUTOR_USER__</string>
  <key>GroupName</key>
  <string>__REVIEWED_EXECUTOR_GROUP__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REVIEWED_VENV_BIN__/trading-harness-executor</string>
    <string>run</string>
    <string>--config</string>
    <string>__REVIEWED_CONFIG_FILE__</string>
    <string>--worker-id</string>
    <string>isolated-testnet-worker</string>
    <string>--max-drain-steps</string>
    <string>20</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REVIEWED_REPO_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>180</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>__REVIEWED_LOG_DIR__/executor.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__REVIEWED_LOG_DIR__/executor.stderr.log</string>
</dict>
</plist>
