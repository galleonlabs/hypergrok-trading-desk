{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pem": "deny",
      "*.wallet": "deny",
      "*.db": "deny",
      "*.sqlite": "deny",
      "*.sqlite*": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pem": "deny",
      "*.wallet": "deny",
      "*.db": "deny",
      "*.sqlite": "deny",
      "*.sqlite*": "deny"
    },
    "bash": {
      "*": "deny",
