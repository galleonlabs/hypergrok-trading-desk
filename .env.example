# Testnet is the safe default.
HYPERGROK_NETWORK=testnet
HYPERGROK_MAX_ORDER_NOTIONAL_USD=1000
HYPERGROK_MAX_SLIPPAGE_BPS=30

# Required only for the one-shot execution command. Never commit a value.
# Use a narrowly authorised Hyperliquid API wallet, not the main wallet.
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_ACCOUNT_ADDRESS=0xYourMainTradingAccount

# Mainnet requires this exact explicit acknowledgement.
# HYPERGROK_ENABLE_MAINNET=I_UNDERSTAND

# Optional CoinGecko Demo or Pro access.
COINGECKO_TIER=keyless
# COINGECKO_API_KEY=
